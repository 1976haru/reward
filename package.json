    "cheerio": "latest",
    "cors": "latest",
    "docx": "^9.6.1",
    "dotenv": "latest",
    "express": "latest",
    "nanoid": "latest",
    "openai": "latest",
    "playwright": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
