{
  "name": "reward-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic public-report evidence builder MVP for online false advertising analysis.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
