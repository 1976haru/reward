# Reward Agent MVP — environment example
# Copy this file to .env and fill in values that you actually need.
# Do NOT commit your real .env file.

# 서버 실행 포트 (현재 README/UI 기준 3001 권장)
PORT=3001

# AI 분석 모드
# - true: OpenAI API를 호출하지 않고 규칙 기반 mock 분석으로 동작 (OPENAI_API_KEY 없이도 시연 가능)
# - false: OPENAI_API_KEY가 있으면 실제 모델 호출
MOCK_AI=true

# OpenAI API 키 (MOCK_AI=false 일 때만 사용됨)
OPENAI_API_KEY=

# AI 모델 (MOCK_AI=false 일 때만 사용됨)
AI_MODEL=gpt-4.1-mini

# Analyzer Agent용 OpenAI 모델/온도 (AI_MODEL 미지정 시 fallback)
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1

# 데이터 루트
DATA_DIR=./data

# 증거 패키지 저장 경로 (기본: $DATA_DIR/evidence)
EVIDENCE_DIR=./data/evidence

# Playwright 캡처 타임아웃 (ms)
EVIDENCE_CAPTURE_TIMEOUT_MS=15000

# 스크린샷/PDF 캡처 사용 여부 (false면 HTML/TXT만 저장)
EVIDENCE_ENABLE_SCREENSHOT=true
EVIDENCE_ENABLE_PDF=true

# Candidate Discovery
# - true: 외부 검색 API 없이 mock 후보 생성 (개발/시연용)
# - false: SearchApiDiscovery (현재 placeholder, NOT_IMPLEMENTED 응답)
MOCK_DISCOVERY=true
DISCOVERY_MAX_CANDIDATES=30

# Scout Agent (체크리스트 18)
# - MOCK_SCOUT=true: 외부 API 없이 mock 후보 생성
# - SCOUT_DAILY_LIMIT: 운영 목표 (실제 수집은 키/소스/약관에 따라 다름)
MOCK_SCOUT=true
SCOUT_DAILY_LIMIT=50

# Naver Search API (선택) — 둘 다 있을 때만 활성화
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 향후 확장 어댑터 (현재는 placeholder)
OPENAI_WEB_SEARCH_ENABLED=false
RSS_SCOUT_ENABLED=false

# Scheduler (체크리스트 19) — 정기 후보 수집
# - 기본 false. true일 때만 node-cron이 등록된다.
# - 테스트 환경(NODE_ENV=test)에서는 SCHEDULER_ENABLED 값에 관계없이 자동 시작하지 않는다.
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_MODE=standard
SCHEDULER_TOPICS=blood-sugar,joint-cartilage,diet-body-fat,liver-detox,immunity
SCHEDULER_SOURCES=mock
SCHEDULER_MAX_CANDIDATES=30
SCHEDULER_RETRY_ATTEMPTS=2
SCHEDULER_RETRY_DELAY_MS=2000
SCHEDULER_MAX_RUN_LOG=200

# 신고서 초안 저장 경로 (기본: $DATA_DIR/reports)
REPORTS_DIR=./data/reports

# Repository 모드
# - false: 파일 기반 JSON 저장소 사용 (기본)
# - true:  Prisma 저장소 사용 (다음 체크리스트에서 도입 예정. 현재는 true여도 JSON으로 폴백)
USE_DB=false

# Prisma 연결 문자열 (USE_DB=true 일 때 사용)
DATABASE_URL="file:./dev.db"

# Feedback DB (체크리스트 21) — 검토자 반려/오탐/보류 사유 누적
# - FEEDBACK_DIR: 로컬 JSON 저장소 경로 (기본 ./data/feedback)
# - FEEDBACK_USE_DB: Prisma 저장소 사용 여부. 기본 false. true여도 Prisma 미연결 시 JSON 폴백.
FEEDBACK_DIR=./data/feedback
FEEDBACK_USE_DB=false

# Eval Set (체크리스트 22) — 합성 평가셋 기반 탐지 품질 측정
# - EVAL_DIR: 평가 실행 결과 저장 경로 (기본 ./data/eval). 결과 JSON은 gitignored.
# - EVAL_DEFAULT_SET: 기본 평가셋 id. 모듈 폴더의 eval/*.json 에 위치.
# - EVAL_THRESHOLD: 양성/음성 판정 임계값 (priority score 기준, 0..100).
# - EVAL_USE_LLM: 평가에 AnalyzerAgent(LLM) 사용 여부. 기본 false. true일 때만 LLM 호출.
# - EVAL_MAX_SAMPLES: 한 번에 실행할 최대 샘플 수.
EVAL_DIR=./data/eval
EVAL_DEFAULT_SET=health_false_ad_synthetic_v1
EVAL_THRESHOLD=60
EVAL_USE_LLM=false
EVAL_MAX_SAMPLES=200

# Trace Log (체크리스트 27) — Agent 실행/판단/툴 호출/사람 수정 내역 감사로그
# - TRACE_ENABLED=true 일 때만 trace 이벤트가 기록된다.
# - TRACE_DIR: JSONL 파일이 저장될 경로. 일자별 파일 분리 (yyyy-mm-dd.jsonl).
# - TRACE_MAX_INPUT_CHARS / TRACE_MAX_OUTPUT_CHARS: input/output 요약 최대 길이.
# - TRACE_MASK_SENSITIVE=true: API 키/토큰/이메일/전화/주민번호/cookie/Authorization 마스킹.
# - TRACE_STORE_FULL_PROMPT=false: 기본은 false (요약/메타만 저장). true 로 두지 말 것.
TRACE_ENABLED=true
TRACE_DIR=./data/traces
TRACE_MAX_INPUT_CHARS=2000
TRACE_MAX_OUTPUT_CHARS=2000
TRACE_MASK_SENSITIVE=true
TRACE_STORE_FULL_PROMPT=false

# Privacy / Data Minimization (체크리스트 28)
# - PRIVACY_MASKING_ENABLED: 메모/리포트/피드백 저장 전 마스킹 사용 여부 (기본 true)
# - PRIVACY_SCAN_DIRS: 스캔 대상 루트 (기본 ./data)
# - PRIVACY_*_RETENTION_DAYS: 카테고리별 보존기간
# - PRIVACY_DRY_RUN: 삭제 API 기본 dry-run 동작 (실제 삭제는 명시 요청 필요)
PRIVACY_MASKING_ENABLED=true
PRIVACY_SCAN_DIRS=./data
PRIVACY_RETENTION_DAYS=90
PRIVACY_TRACE_RETENTION_DAYS=30
PRIVACY_EVIDENCE_RETENTION_DAYS=90
PRIVACY_REPORT_RETENTION_DAYS=90
PRIVACY_FEEDBACK_RETENTION_DAYS=180
PRIVACY_CASE_RETENTION_DAYS=180
PRIVACY_RAW_RETENTION_DAYS=30
PRIVACY_SCHEDULER_RETENTION_DAYS=90
PRIVACY_SCOUT_RETENTION_DAYS=90
PRIVACY_DRY_RUN=true

# Outcome Tracker (체크리스트 30)
# - OUTCOME_DIR: 결과 기록 JSON 저장 경로 (기본 ./data/outcomes)
# - OUTCOME_USE_DB: Prisma 사용 여부 (기본 false — JSON 폴백)
# - OUTCOME_DEFAULT_FOLLOWUP_DAYS: 다음 확인일 자동 제안 일수
OUTCOME_DIR=./data/outcomes
OUTCOME_USE_DB=false
OUTCOME_DEFAULT_FOLLOWUP_DAYS=14
