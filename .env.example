# Reward Agent MVP — environment example
# Copy this file to .env and fill in values that you actually need.
# Do NOT commit your real .env file.

# 서버 실행 포트 (현재 README/UI 기준 3001 권장)
PORT=3001

# AI 분석 모드
# - true: OpenAI API를 호출하지 않고 규칙 기반 mock 분석으로 동작 (OPENAI_API_KEY 없이도 시연 가능)
# - false: OPENAI_API_KEY가 있으면 실제 모델 호출
MOCK_AI=true

# OpenAI API 키 (MOCK_AI=false 일 때만 사용됨)
OPENAI_API_KEY=

# AI 모델 (MOCK_AI=false 일 때만 사용됨)
AI_MODEL=gpt-4.1-mini

# Analyzer Agent용 OpenAI 모델/온도 (AI_MODEL 미지정 시 fallback)
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1

# 데이터 루트
DATA_DIR=./data

# 증거 패키지 저장 경로 (기본: $DATA_DIR/evidence)
EVIDENCE_DIR=./data/evidence

# Playwright 캡처 타임아웃 (ms)
EVIDENCE_CAPTURE_TIMEOUT_MS=15000

# 스크린샷/PDF 캡처 사용 여부 (false면 HTML/TXT만 저장)
EVIDENCE_ENABLE_SCREENSHOT=true
EVIDENCE_ENABLE_PDF=true

# Candidate Discovery
# - true: 외부 검색 API 없이 mock 후보 생성 (개발/시연용)
# - false: SearchApiDiscovery (현재 placeholder, NOT_IMPLEMENTED 응답)
MOCK_DISCOVERY=true
DISCOVERY_MAX_CANDIDATES=30

# 신고서 초안 저장 경로 (기본: $DATA_DIR/reports)
REPORTS_DIR=./data/reports

# Repository 모드
# - false: 파일 기반 JSON 저장소 사용 (기본)
# - true:  Prisma 저장소 사용 (다음 체크리스트에서 도입 예정. 현재는 true여도 JSON으로 폴백)
USE_DB=false

# Prisma 연결 문자열 (USE_DB=true 일 때 사용)
DATABASE_URL="file:./dev.db"
