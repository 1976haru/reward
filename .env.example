# Reward Agent MVP — environment example
# Copy this file to .env and fill in values that you actually need.
# Do NOT commit your real .env file.

# 서버 실행 포트 (현재 README/UI 기준 3001 권장)
PORT=3001

# AI 분석 모드
# - true: OpenAI API를 호출하지 않고 규칙 기반 mock 분석으로 동작 (OPENAI_API_KEY 없이도 시연 가능)
# - false: OPENAI_API_KEY가 있으면 실제 모델 호출
MOCK_AI=true

# OpenAI API 키 (MOCK_AI=false 일 때만 사용됨)
OPENAI_API_KEY=

# AI 모델 (MOCK_AI=false 일 때만 사용됨)
AI_MODEL=gpt-4.1-mini

# 데이터 루트
DATA_DIR=./data

# 증거 패키지 저장 경로 (기본: $DATA_DIR/evidence)
EVIDENCE_DIR=./data/evidence

# 신고서 초안 저장 경로 (기본: $DATA_DIR/reports)
REPORTS_DIR=./data/reports
