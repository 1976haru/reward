    { "id": "OL_H003", "keyword": "원산지 별도 표기 없음", "riskLevel": "HIGH", "weight": 25, "category": "origin_missing", "reason": "원산지를 별도로 표기하지 않는다는 표현 — 누락 의심. 검토 필요", "examples": ["원산지 별도 표기 없음"], "matchType": "keyword" },
