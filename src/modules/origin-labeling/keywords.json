    { "id": "OL_H006", "keyword": "국산으로 판매", "riskLevel": "HIGH", "weight": 25, "category": "origin_mismatch", "reason": "실제 원산지와 다르게 국산으로 표시·판매할 가능성 — 표시 불일치 의심. 검토 필요", "examples": ["수입 원료를 국산으로 판매"], "matchType": "keyword" },
